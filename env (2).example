# ================================================================
# .env.example — Modelo de variáveis de ambiente
# ================================================================
# NÃO suba o arquivo .env para o GitHub!
# Cadastre essas variáveis no Vercel:
#   Settings → Environment Variables
# ================================================================

# ── PLANILHA DE PRODUTOS ────────────────────────────────────────
# Link da planilha publicada como CSV no Google Sheets
# Arquivo → Publicar na Web → Planilha inteira → CSV → Copiar link
SHEET_URL=https://docs.google.com/spreadsheets/d/SEU_ID/pub?output=csv

# ── CREDENCIAIS e.REDE ──────────────────────────────────────────
REDE_PV=48087130
REDE_TOKEN=f2e49b858d864e30aacbdefa6d20eb93

# "true" para sandbox/testes, "false" para produção
REDE_SANDBOX=true

# ── SUPABASE (painel admin + registro de pedidos) ───────────────
# Acesse app.supabase.com → seu projeto → Settings → API
# "Project URL":
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# "service_role key" (para o backend salvar pedidos):
SUPABASE_KEY=sua_service_role_key_aqui

# ================================================================
# QUANDO FOR PARA PRODUÇÃO:
#   1. Troque REDE_PV e REDE_TOKEN pelas credenciais de produção
#   2. Mude REDE_SANDBOX para false
#   3. Atualize no Vercel → Environment Variables
# ================================================================
